# ============================================================================
#  PRICELESS BUNDLE — environment
#  Copy to .env.local (development) or paste into your host's env settings.
# ============================================================================

# ---------------------------------------------------------------------------
# DATABASE — pick ONE transport.
# ---------------------------------------------------------------------------
# Option A (production, Supabase REST/RPC): the app calls Postgres functions
# through PostgREST with the service-role key. NEVER expose this key to the
# browser — it bypasses row level security by design.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Option B (direct Postgres — recommended for Supabase too, and required for
# local development): connection string straight to Postgres.
# Supabase dashboard -> Project Settings -> Database -> Connection string -> URI
# DATABASE_URL=postgresql://postgres:PASSWORD@db.your-project.supabase.co:5432/postgres

# Local development with the bundled PGlite server (npm run dev:local):
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55432/postgres

# ---------------------------------------------------------------------------
# SESSIONS — sign 32+ random characters. Required in production.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ---------------------------------------------------------------------------
SESSION_SECRET=change-me-to-32-random-characters-minimum-for-priceless-bundle

# ---------------------------------------------------------------------------
# SMS DEPOSIT WEBHOOK — the shared secret your Android SMS-forwarder app sends.
# Header name defaults to x-priceless-secret.
# ---------------------------------------------------------------------------
SMS_WEBHOOK_SECRET=change-me-to-a-long-random-string
# SMS_WEBHOOK_HEADER=x-priceless-secret

# ---------------------------------------------------------------------------
# ADMIN / OPERATOR ACCESS — sign in at /login with these.
# CHANGE BOTH before launch.
# ---------------------------------------------------------------------------
ADMIN_PHONE=0244000000
ADMIN_PIN=246810

# ---------------------------------------------------------------------------
# PUBLIC URL — used when registering webhooks with Telegram / WhatsApp.
# ---------------------------------------------------------------------------
PUBLIC_BASE_URL=https://your-deployment.example.com

# ---------------------------------------------------------------------------
# BOT-IN-A-BOX (optional)
# ---------------------------------------------------------------------------
# TELEGRAM_WEBHOOK_SECRET=another-random-string
# WHATSAPP_ACCESS_TOKEN=EAAG...
# WHATSAPP_CLOUD_API_URL=https://graph.facebook.com/v21.0

# ---------------------------------------------------------------------------
# SUPPLIER — the real DataMartGH reseller API (see src/lib/supplier.ts).
# While DATAMARTGH_API_KEY is unset the app uses the ~95%-success mock.
# ---------------------------------------------------------------------------
# DATAMARTGH_API_KEY=
# DATAMARTGH_BASE_URL=https://api.datamartgh.com

# Mock tuning (development / QA only)
# SUPPLIER_SUCCESS_RATE=0.95
# SUPPLIER_MOCK_MODE=random        # random | always_succeed | always_fail

# Local development only — never enable in production
NODE_ENV=development
